# ─────────────────────────────────────────────────────────────────────────────
# UrbanBlade Analytics — Variables de entorno (Spark / MongoDB Atlas)
# ─────────────────────────────────────────────────────────────────────────────
# 1. Copia este archivo a ".env" en la raíz del proyecto:  cp .env.example .env
# 2. Pide los valores reales al responsable del proyecto (NO se comparten aquí,
#    NO se suben a git — el .env real está en .gitignore).
# 3. Verifica la conexión con:
#      python config/mongo_spark_conexion_sinnulos.py
# ─────────────────────────────────────────────────────────────────────────────

# Usuario de la base de datos en MongoDB Atlas
# (Atlas → Database Access → Database Users)
# Sólo para validación local aislada; en Atlas debe quedar vacía.
CORE_MONGODB_URI=

MONGO_USER=

# Contraseña del usuario anterior
# (Atlas → Database Access → Edit → Edit Password)
MONGO_PASSWORD=

# Host del clúster, SIN "mongodb+srv://" ni credenciales — solo el dominio
# (Atlas → Database → Connect → Drivers → copia solo la parte "xxxxx.mongodb.net")
# Ejemplo de formato: cluster0.ab12cde.mongodb.net
MONGO_CLUSTER=

# Nombre de la base de datos dentro del clúster
MONGO_DB=barber_db

# Destino separado para derivados. Este usuario sólo debe poder escribir en
# ANALYTICS_MONGO_DB; no reutilices las credenciales de lectura del core.
# En validación local aislada puede usarse ANALYTICS_MONGODB_URI; en Atlas se
# deja vacía y se usan las cuatro variables de credenciales separadas.
ANALYTICS_MONGODB_URI=
ANALYTICS_MONGO_USER=
ANALYTICS_MONGO_PASSWORD=
ANALYTICS_MONGO_CLUSTER=
ANALYTICS_MONGO_DB=urbanblade_analytics

# ─────────────────────────────────────────────────────────────────────────────
# Opcional — solo si vas a correr data_ingestion/generar_datos_urbanblade.py
# (generador de datos SINTÉTICOS de prueba; nunca se usa contra la BD real)
# ─────────────────────────────────────────────────────────────────────────────
MONGO_COLLECTION_SYNTHETIC=appointments_synthetic

# ─────────────────────────────────────────────────────────────────────────────
# Login con Google del dashboard (main_dashboard.py) — reutiliza el mismo
# Google OAuth ya configurado en barber (GOOGLE_CLIENT_ID/SECRET viven ahí,
# NUNCA aquí).
# BARBER_API_URL: usada por Python para verificar el token server-to-server
#   (GET /api/v1/auth/me). Corriendo con `streamlit run` normal, es la misma
#   que BARBER_PUBLIC_URL. Corriendo con docker-compose.yml de este repo,
#   docker-compose.yml ya la sobreescribe a "http://web" (nombre del
#   servicio nginx de barber dentro de la red compartida) — no la cambies
#   a mano ahí.
# BARBER_PUBLIC_URL: la URL que abre el NAVEGADOR del usuario al hacer clic
#   en "Iniciar sesión con Google". Debe ser alcanzable desde donde sea que
#   el usuario tenga su navegador (normalmente localhost:8000 en desarrollo).
# ─────────────────────────────────────────────────────────────────────────────
BARBER_API_URL=http://localhost:8000
BARBER_PUBLIC_URL=http://localhost:8000
