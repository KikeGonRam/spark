# Configuración de desarrollo. Nunca copiar credenciales a este archivo.
# CORE_MONGODB_URI sirve para Mongo local o una URI explícita de solo lectura.
# Alternativamente usar MONGO_USER/PASSWORD/CLUSTER para Atlas.
# MONGODB_URI del backend no se usa como fallback: podría ser una credencial privilegiada.
CORE_MONGODB_URI=
MONGO_USER=
MONGO_PASSWORD=
MONGO_CLUSTER=
MONGO_DB=barber_db

# Conexión de derivados: obligatoriamente distinta del core.
ANALYTICS_MONGODB_URI=
ANALYTICS_MONGO_USER=
ANALYTICS_MONGO_PASSWORD=
ANALYTICS_MONGO_CLUSTER=
ANALYTICS_MONGO_DB=urbanblade_analytics
MONGO_COLLECTION_SYNTHETIC=appointments_synthetic

# Escrituras bloqueadas por defecto; la CLI exige además --publish o --apply.
ALLOW_ANALYTICS_PUBLICATION=false
ALLOW_SYNTHETIC_WRITES=false

# Autenticación: servidor a servidor y URL accesible para el navegador.
BARBER_API_URL=http://localhost:8000
BARBER_PUBLIC_URL=http://localhost:8000
BARBER_DOCKER_NETWORK=barber_internal
